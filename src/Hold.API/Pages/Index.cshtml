@page
@model Hold.API.Pages.IndexModel

@{
  ViewData["Title"] = "Home page";
}

<h1>Welcome to Hold.API</h1>
<p>
  Manage your bank accounts.
</p>
<ul>
  <li><a href="/Accounts">View Accounts</a></li>
</ul>

<hr />

@if (Model.ShowPosts) {
  <h2>Posts</h2>
  <details style="margin-bottom: 20px; border: 1px solid #eee; padding: 15px;">
    <summary style="cursor: pointer; font-weight: bold; font-size: 1.2em;">Add New Post</summary>
    <form method="post" style="margin-top: 15px;">
      <div style="margin-bottom: 10px;">
        <label for="title">Title</label><br />
        <input type="text" id="title" name="title" required style="width: 100%;" />
      </div>
      <div style="margin-bottom: 10px;">
        <label for="body">Body</label><br />
        <textarea id="body" name="body" required style="width: 100%; height: 100px;"></textarea>
      </div>
      <button type="submit">Post</button>
    </form>
  </details>

  @if (Model.Posts != null && Model.Posts.Any()) {
    @foreach (var post in Model.Posts) {
      <div style="border: 1px solid #ccc; margin-bottom: 10px; padding: 10px;">
        <h3>@post.Title</h3>
        <p>@post.Body</p>
        <small>@post.Time.ToString("yyyy-MM-dd HH:mm")</small>
      </div>
    }
  } else {
    <p>No posts yet.</p>
  }
}
